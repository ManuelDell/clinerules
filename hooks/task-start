#!/bin/bash
# Hook: task-start
# 1. Legt .cline/ als einziges Cline-Arbeitsverzeichnis an (gitignored)
# 2. Injiziert Stack-Status als Context wenn OpenRouter AI Stack läuft

# ── .cline/ Setup ────────────────────────────────────────────────────────────

WORKSPACE="${PWD}"
CLINE_DIR="${WORKSPACE}/.cline"
GITIGNORE="${WORKSPACE}/.gitignore"

# Verzeichnisse anlegen
mkdir -p "${CLINE_DIR}/plans"

# .cline/ in .gitignore eintragen (einmalig)
if [[ -f "$GITIGNORE" ]]; then
    if ! grep -qxF ".cline/" "$GITIGNORE"; then
        echo ".cline/" >> "$GITIGNORE"
    fi
else
    echo ".cline/" > "$GITIGNORE"
fi

# ── Stack-Status prüfen ──────────────────────────────────────────────────────

ROUTER_STATUS=$(curl -s --max-time 2 http://localhost:8085/health 2>/dev/null \
    | python3 -c "import json,sys; print(json.load(sys.stdin).get('status','?'))" 2>/dev/null \
    || echo "offline")

if [[ "$ROUTER_STATUS" == "ok" ]]; then
    STACK_INFO="OpenRouter Stack: ONLINE (Router=8085 Memory=8086 MCP=8087 WebUI=8088)"
else
    STACK_INFO="OpenRouter Stack: nicht erreichbar"
fi

# ── Context zusammenstellen ──────────────────────────────────────────────────

MSG="Arbeitsverzeichnis: ${WORKSPACE}
Cline-Arbeitsdaten: ${CLINE_DIR}/ (gitignored)
${STACK_INFO}"

echo "{\"cancel\": false, \"contextModification\": $(echo "$MSG" | python3 -c "import json,sys; print(json.dumps(sys.stdin.read()))")}"
